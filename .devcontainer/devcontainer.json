{
  // Run Narrated Slides in GitHub Codespaces: everything starts by itself.
  // Pick a 4-core / 16 GB machine or bigger (voice cloning needs the memory).
  "name": "Narrated Slides",
  // GitHub's default Codespaces image: Docker is already installed and running.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000, 5001],
  "portsAttributes": {
    "8000": { "label": "Narrated Slides", "onAutoForward": "openBrowser" },
    "5001": { "label": "Presenton", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
