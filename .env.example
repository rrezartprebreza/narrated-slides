# Copy to .env:  cp .env.example .env
# Lines starting with # are ignored.

# ---------- Presenton (slide generation) ----------
# Local, free: Presenton uses the Ollama container (start it with --profile ollama).
LLM=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Or use a hosted model instead (and drop the three Ollama lines above):
# LLM=openai
# OPENAI_API_KEY=sk-...
# Slide images need an image provider, e.g. a free Pexels key:
# IMAGE_PROVIDER=pexels
# PEXELS_API_KEY=...

# Presenton sends anonymous usage statistics unless you turn this on (uncomment to opt out):
# DISABLE_ANONYMOUS_TRACKING=true

# ---------- Narrator app ----------
# Voice used by default (Kokoro voice name, e.g. af_heart, af_bella, am_michael, bf_emma)
TTS_VOICE=af_heart

# Model that writes missing speaker notes. Defaults to the Ollama container above.
NOTES_LLM_BASE_URL=http://ollama:11434/v1
NOTES_LLM_MODEL=llama3.2:3b
# To use OpenAI instead:
# NOTES_LLM_BASE_URL=https://api.openai.com/v1
# NOTES_LLM_MODEL=gpt-4.1-mini
# NOTES_LLM_API_KEY=sk-...

# Lets the narrator app generate decks through Presenton. Create the key in Presenton
# (http://localhost:5001), paste it here, then: docker compose up -d
# PRESENTON_API_KEY=sk-presenton-...

# Start optional add-ons with every "docker compose up" (ollama = AI notes and translation, clone = your own voice):
# COMPOSE_PROFILES=ollama,clone

# Voice cloning model: turbo (fast, default) or standard (slower, supports Emotion)
# CLONE_MODEL=turbo

# Extra Piper voices (Albanian is included by default). name=URL-of-model.onnx, comma separated:
# PIPER_VOICES=sq_arben=https://huggingface.co/edonseki/folsh.ai/resolve/main/arben/sq_AL-arben-medium.onnx,sq_arta=https://huggingface.co/edonseki/folsh.ai/resolve/main/arta/sq_AL-arta-medium.onnx,sq_dren=https://huggingface.co/edonseki/folsh.ai/resolve/main/dren/sq_AL-dren-medium.onnx,sq_edon=https://huggingface.co/edonseki/folsh.ai/resolve/main/edon/sq_AL-edon-medium.onnx

# ---------- Ports (all bound to 127.0.0.1 only) ----------
# NARRATOR_PORT=8000
# PRESENTON_PORT=5001
# KOKORO_PORT=8880

# ---------- Housekeeping ----------
# MAX_UPLOAD_MB=100
# RETENTION_DAYS=7        # old decks and videos are deleted after this many days (0 = keep forever)
# Use a different image version than the tested one in docker-compose.yml:
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
# PRESENTON_IMAGE=ghcr.io/presenton/presenton:latest
